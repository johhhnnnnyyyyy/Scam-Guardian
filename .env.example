HOST=127.0.0.1
PORT=3000
# Required only for actual Prisma/Timbre calls. Never expose to the browser.
GNANI_API_KEY=
# Required (owner decision 25): the server refuses to start without LLM_API_KEY and LLM_MODEL.
# For local development only, ALLOW_RULES_ONLY=1 starts it with rules-only detection.
ALLOW_RULES_ONLY=0
LLM_API_KEY=
# Any OpenAI-compatible provider works; set the base URL (no trailing slash, no /chat/completions) and a fast model
# (the call has a 4 s timeout). Examples:
#   OpenAI      https://api.openai.com/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai   (model: gemini-2.5-flash-lite)
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Ollama      http://localhost:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# Optional Web Push. Keep both VAPID keys private to the server. Enable only in a secured deployment.
ENABLE_PUSH=0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# For phones or tablets you need HTTPS (e.g. a Cloudflare tunnel). Set the public origin, list its host (no scheme, NO
# spaces after commas), and enable secure cookies:
#   PUBLIC_ORIGIN=https://your-name.trycloudflare.com
#   ALLOWED_HOSTS=your-name.trycloudflare.com,127.0.0.1,localhost
#   SECURE_COOKIES=1
PUBLIC_ORIGIN=
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
# Decision 8: keep family accounts, senior profiles (including the voice print) and device credentials across
# restarts. Sessions, transcripts and audio are never written. The state file is owner-only (0600).
DATA_DIR=
# Decision 11: paid provider calls per day (default 500) and any limit as LIMIT_<RULE>=capacity[/perSeconds].
PROVIDER_DAILY_CAP=500
# LIMIT_SESSION_CREATE=20/3600
