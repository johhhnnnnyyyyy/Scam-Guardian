HOST=127.0.0.1
PORT=3000
# Required only for actual Prisma/Timbre calls. Never expose to the browser.
GNANI_API_KEY=
# Optional; rules-only detection works without an LLM.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
# Optional Web Push. Keep both VAPID keys private to the server. Enable only in a secured deployment.
ENABLE_PUSH=0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Set to the public HTTPS origin when creating QR setup links across devices.
PUBLIC_ORIGIN=
ALLOWED_HOSTS=127.0.0.1,localhost,[::1]
